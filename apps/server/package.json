{
  "name": "@isputnik/games-server",
  "private": true,
  "version": "0.15.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node --input-type=module -e \"import('node:fs').then(fs => fs.copyFileSync('src/schema.sql', 'dist/schema.sql'))\"",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@isputnik/games-engine": "0.15.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "nanoid": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
